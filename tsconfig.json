{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vinxi/types/client", "vite/client", "bun-types"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "*.ts", "*.tsx"]
}
